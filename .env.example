# I-9 Document Processing System - Environment Configuration
# Copy this file to .env and update with your actual values

# API Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.ai.it.cornell.edu/
I9_MODEL_NAME=google.gemini-2.5-pro

# Processing Configuration
I9_MAX_WORKERS=4
I9_RATE_LIMIT_DELAY=1.0
I9_MAX_RETRIES=3
I9_TIMEOUT_SECONDS=60

# PDF Processing
I9_IMAGE_SCALE_FACTOR=3.5
I9_MAX_PDF_SIZE_MB=50

# Hybrid Extraction (RECOMMENDED)
PDF_DPI=300
PDF_IMAGE_FORMAT=PNG
PDF_IMAGE_QUALITY=100
HYBRID_EXTRACTION_ENABLED=True

# Batch Processing
CATALOG_BATCH_SIZE=1

# Detection Configuration
I9_CONFIDENCE_THRESHOLD=0.7
I9_ENABLE_FALLBACK=true

# Logging Configuration
I9_LOG_LEVEL=INFO
I9_LOG_FILE=logs/i9_processor.log

# =============================================================================
# DIRECTORY CONFIGURATION
# =============================================================================

# Input directory containing PDF files to process
INPUT_FOLDER=data/input

# Output directory for all generated files
OUTPUT_FOLDER=workdir

# Subdirectories (relative to OUTPUT_FOLDER)
CATALOGS_FOLDER=catalogs
AUDIT_LOGS_FOLDER=audit_logs
FIELD_AUDITS_FOLDER=field_level_audits
FIELD_AUDIT_TABLES_FOLDER=field_audit_tables
FIELD_AUDIT_REPORTS_FOLDER=field_audit_reports

# =============================================================================
# CATALOG GENERATION CONFIGURATION
# =============================================================================

# Catalog generation mode:
#   - "use_existing": Use existing catalogs if available, generate only missing ones
#   - "force_regenerate": Force regenerate all catalogs from PDFs
#   - "skip": Skip catalog generation entirely (use existing catalogs only)
CATALOG_MODE=use_existing

# Force regenerate catalogs even if they exist (legacy, use CATALOG_MODE instead)
FORCE_REGENERATE_CATALOGS=false

# =============================================================================
# PROCESSING PIPELINE CONFIGURATION
# =============================================================================

# Enable/disable pipeline stages
GENERATE_CATALOGS=true
PROCESS_RUBRICS=true
GENERATE_CSV=true
GENERATE_FIELD_AUDITS=true
GENERATE_SUMMARY=true

# =============================================================================
# OUTPUT CONFIGURATION
# =============================================================================

# Main CSV output filename
CSV_OUTPUT_FILENAME=rubric_based_results.csv

# Summary report filename
SUMMARY_FILENAME=REGENERATION_SUMMARY.txt
